{
	"name": "wedding-invitation-template",
	"version": "1.0.0",
	"description": "Mobile-first wedding invitation website with scroll animations, a countdown, an RSVP form and link-preview metadata, configured from a single file.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "npm run lint:js && npm run lint:css && npm run format:check",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"**/*.scss\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.7.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.1.1",
		"prettier": "^3.9.6",
		"sass": "^1.101.3",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"vite": "^8.1.1"
	},
	"lint-staged": {
		"*.{js,gs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.scss": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.{html,json,md,yml}": [
			"prettier --write"
		]
	}
}
