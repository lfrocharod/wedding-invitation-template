# Copy to .env.local for local development, or set these in your host's dashboard.
# Vite inlines VITE_* variables into the public JS bundle at build time.

# RSVP backend: "demo" (default) simulates a successful submission without any
# network call; "apps-script" sends answers to your Google Apps Script web app.
VITE_RSVP_MODE=demo

# Web app URL from Apps Script > Deploy > Manage deployments (it ends in /exec).
# Only used, and then required, when VITE_RSVP_MODE=apps-script.
VITE_RSVP_ENDPOINT=
